e":"int","value":902},{"name":"page","type":"int","value":6}],"polyline":[{"x":0,"y":0},{"x":0,"y":262}]},{"id":834,"x":-707,"y":910,"visible":true,"properties":[{"name":"ladder_id","type":"int","value":17},{"name":"l","type":"int","value":1},{"name":"x","type":"int","value":-707},{"name":"uf","type":"int","value":1},{"name":"y1","type":"int","value":910},{"name":"y2","type":"int","value":1176},{"name":"page","type":"int","value":7}],"polyline":[{"x":0,"y":0},{"x":0,"y":266}]}]},{"id":47,"name":"miniMap","type":"objectgroup","visible":true,"opacity":1,"objects":[{"id":835,"x":1688,"y":399,"visible":true,"properties":[{"name":"mag","type":"int","value":4},{"name":"centerX","type":"int","value":1688},{"name":"centerY","type":"int","value":399},{"name":"canvas_path","type":"string","value":"../../images/30507.png"},{"name":"canvas_width","type":"int","value":120},{"name":"canvas_height","type":"int","value":123},{"name":"canvas_origin_x","type":"int","value":0},{"name":"canvas_origin_y","type":"int","value":0}],"point":true}]}],"tilesets":[{"firstgid":1,"source":"../../tilesets/bg_shineWood.tsj"},{"firstgid":35,"source":"../../tilesets/tile_woodBridge.tsj"},{"firstgid":45,"source":"../../tilesets/obj_connect_ladder_0.tsj"},{"firstgid":50,"source":"../../tilesets/obj_houseSW_house1_deco.tsj"},{"firstgid":52,"source":"../../tilesets/obj_houseSW_house2_basic.tsj"},{"firstgid":53,"source":"../../tilesets/obj_houseSW_house7_basic.tsj"},{"firstgid":54,"source":"../../tilesets/obj_signboard_event_2003summer.tsj"}],"properties":[{"name":"bgm","type":"string","value":"BgmEvent/FunnyRabbit"},{"name":"help","type":"string","value":"#e[올라~ 올라~]#n\\n\\n깜짝 이벤트 게임에 참여해 주신 여러분께 감사 드립니다. 게임에 대한 간단한 설명을 드리겠습니다.\\n\\n[올라~ 올라~]게임은 #b사다리 타기#k와 비슷한 게임 입니다. #r운이 승패를 좌우하는 큰 요소#k입니다.\\n정해진 시간내에 모든 관문을 통과 하시면 상품을 받는 곳으로 이동 됩니다. 관문은 총 #b3단계#k로 이루어져 있습니다.\\n제한 시간은 #r6분#k이고 6분이 지난 후에는 게임이 #b자동 종료#k 됩니다. [올라~올라~]게임에서는 #b점프#k, #b텔레포트#k,#b헤이스트#k 등이 사용 #r불가능#k 합니다.\\n\\n더 궁금하신 사항은 게임내에서 질문하시기 바랍니다.\\n"},{"name":"swim","type":"int","value":0},{"name":"town","type":"int","value":0},{"name":"cloud","type":"int","value":0},{"name":"mapDesc","type":"string","value":""},{"name":"mapMark","type":"string","value":"Event"},{"name":"mobRate","type":"float","value":0},{"name":"version","type":"int","value":10},{"name":"returnMap","type":"int","value":109050001},{"name":"fieldLimit","type":"int","value":467711},{"name":"hideMinimap","type":"int","value":1},{"name":"forcedReturn","type":"int","value":109050001}]}