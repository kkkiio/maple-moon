:"int","value":549},{"name":"y1","type":"int","value":-537},{"name":"y2","type":"int","value":-530},{"name":"next","type":"int","value":0},{"name":"prev","type":"int","value":94}],"polyline":[{"x":0,"y":0},{"x":32,"y":7}]}]},{"id":21,"name":"miniMap","type":"objectgroup","visible":true,"opacity":1,"objects":[{"id":143,"x":602,"y":717,"visible":true,"properties":[{"name":"mag","type":"int","value":4},{"name":"centerX","type":"int","value":602},{"name":"centerY","type":"int","value":717},{"name":"canvas_path","type":"string","value":"../../images/30655.png"},{"name":"canvas_width","type":"int","value":76},{"name":"canvas_height","type":"int","value":80},{"name":"canvas_origin_x","type":"int","value":0},{"name":"canvas_origin_y","type":"int","value":0}],"point":true}]}],"tilesets":[{"firstgid":1,"source":"../../tilesets/bg_shineWood.tsj"},{"firstgid":34,"source":"../../tilesets/obj_acc2_shineWood_foot.tsj"},{"firstgid":61,"source":"../../tilesets/obj_acc1_darkWood_nature.tsj"},{"firstgid":67,"source":"../../tilesets/obj_acc2_shineWood_flower.tsj"},{"firstgid":85,"source":"../../tilesets/obj_acc2_shineWood_minidungeon.tsj"}],"properties":[{"name":"bgm","type":"string","value":"Bgm02/WhenTheMorningComes"},{"name":"help","type":"string","value":"#e[보물찾기]#n\\n\\n깜짝 이벤트 게임에 참여해 주신 여러분께 감사 드립니다. 게임에 대한 간단한 설명을 드리겠습니다.\\n\\n[보물찾기]게임은 각 필드에 숨겨진 #b보물지도를 찾는 게임#k입니다. 위에 보시면 4개의 포탈이 있는데 각각 독립된 방입니다.\\n각 방에는 #b10장의 보물지도#k가 숨겨져 있습니다. 보물지도를 획득하는 방법은 일반 아이템을 획득하는 방법과 동일 합니다. Z 혹은 0을 누르시면 아이템을 획득할 수 있습니다.\\n이 게임에는 #r숨겨진 포탈#k, #r숨겨진 텔레포트 장소#k가 존재 합니다. 숨겨진 포탈, 텔레포트 장소를 이용하시려면 특정 장소에서 #b↑#k를 누르시면 됩니다. #r숨겨진 계단#k이나 #r밧줄#k도 존재하니 안보이는 곳에서 점프도 해 보세요.\\n게임 시간이 다 되거나 지도가 필드에서 모두 사라지면 이벤트는 종료 됩니다.\\n[보물찾기]게임에서는 #b텔레포트#k, #b헤이스트#k 사용이 #r불가능#k 합니다.\\n\\n더 궁금하신 사항은 게임내에서 질문하시기 바랍니다.\\n"},{"name":"town","type":"int","value":1},{"name":"cloud","type":"int","value":0},{"name":"mapDesc","type":"string","value":""},{"name":"mapMark","type":"string","value":"None"},{"name":"mapName","type":"string","value":"인내의숲<1단계>"},{"name":"mobRate","type":"float","value":1.1999982595443726},{"name":"version","type":"int","value":10},{"name":"returnMap","type":"int","value":101000000},{"name":"fieldLimit","type":"int","value":0},{"name":"streetName","type":"string","value":"히든스트리트"},{"name":"hideMinimap","type":"int","value":0},{"name":"forcedReturn","type":"int","value":999999999}]}