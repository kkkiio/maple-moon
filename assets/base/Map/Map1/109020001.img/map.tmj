,{"firstgid":6,"source":"../../tilesets/bg_grassySoil.tsj"},{"firstgid":13,"source":"../../tilesets/tile_woodMarble.tsj"},{"firstgid":38,"source":"../../tilesets/obj_connect_ladder_0.tsj"},{"firstgid":43,"source":"../../tilesets/obj_connect_ladder_2.tsj"},{"firstgid":46,"source":"../../tilesets/obj_acc1_darkWood_nature.tsj"},{"firstgid":77,"source":"../../tilesets/obj_door_grassySoil_door.tsj"},{"firstgid":92,"source":"../../tilesets/obj_acc1_grassySoil_nature.tsj"},{"firstgid":120,"source":"../../tilesets/obj_signboard_event_2003summer.tsj"},{"firstgid":122,"source":"../../tilesets/obj_acc1_midForest_artificiality.tsj"}],"properties":[{"name":"bgm","type":"string","value":"Bgm00/GoPicnic"},{"name":"help","type":"string","value":"#e[스피드 OX퀴즈]#n\\n\\n깜짝 이벤트 게임에 참여해 주신 여러분께 감사 드립니다. 게임에 대한 간단한 설명을 드리겠습니다.\\n\\n우선 [OX퀴즈]에 참여하신 모든 분들은 #r미니맵#k을 켜두십시오. 미니맵을 켜는 방법은 자판에서 #b'M'#k을 누르시면 됩니다. 미니맵에서 보이는대로 #b왼쪽#k이 #rO#k, #b오른쪽#k이 #rX#k 입니다.\\n문제가 출제되면 정답을 결정한 후 O나 X지역으로 #b사다리#k를 타고 내려가십시오. #b타이머#k에 있는 시간이 모두 지나기 전에 정답을 선택하셔야 합니다. #r중간#k에 머물거나 #r사다리#k에 매달려 있으면 정답이 공개될때 #r자동종료#k 됩니다.\\n문제는 #b총 10문제#k가 출제되며 모든 문제를 다 맞추시면 상품 받는 곳으로 이동됩니다. OX맵에서는 컨닝이나 허위정보 공개등을 막기위하여 #b채팅관련#k 기능이 모두 막혀있습니다.\\n"},{"name":"swim","type":"int","value":0},{"name":"town","type":"int","value":0},{"name":"cloud","type":"int","value":0},{"name":"mapDesc","type":"string","value":""},{"name":"mapMark","type":"string","value":"Event"},{"name":"mobRate","type":"float","value":1},{"name":"version","type":"int","value":10},{"name":"fieldType","type":"int","value":5},{"name":"returnMap","type":"int","value":109050001},{"name":"fieldLimit","type":"int","value":74494},{"name":"hideMinimap","type":"int","value":0},{"name":"forcedReturn","type":"int","value":109050001}]}