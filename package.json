{
	"name": "maple-moon",
	"version": "1.0.0",
	"description": "Maple Moon Game",
	"main": "index.html",
	"directories": {
		"lib": "lib"
	},
	"scripts": {
		"test": "just test",
		"test:graphics:update": "just update-graphics-snaps",
		"moon:build": "npm run moon:build:web",
		"moon:build:web": "moon build --target js --release src/apps/game_web",
		"moon:build:native": "moon build --target native --release src/apps/game_native",
		"predev": "moon run --target js --build-only src/cmd/maple && moon run --target js --build-only src/cmd/mapled && node --enable-source-maps _build/js/debug/build/KKKIIO/maple-moon/cmd/maple/maple.js close",
		"dev": "concurrently --raw --kill-others \"npm:dev:vite\" \"npm:dev:mapled\" \"npm:dev:browser\"",
		"dev:vite": "vite",
		"dev:mapled": "node --enable-source-maps _build/js/debug/build/KKKIIO/maple-moon/cmd/mapled/mapled.js",
		"dev:browser": "node --enable-source-maps _build/js/debug/build/KKKIIO/maple-moon/cmd/maple/maple.js status --wait && node --enable-source-maps _build/js/debug/build/KKKIIO/maple-moon/cmd/maple/maple.js logs --clear && node --enable-source-maps _build/js/debug/build/KKKIIO/maple-moon/cmd/maple/maple.js open --wait && node --enable-source-maps _build/js/debug/build/KKKIIO/maple-moon/cmd/maple/maple.js logs --follow --out logs/browser.log",
		"build": "npm run moon:build:web && vite build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KKKIIO/maple-moon.git"
	},
	"author": "",
	"license": "GPLV3",
	"bugs": {
		"url": "https://github.com/KKKIIO/maple-moon/issues"
	},
	"homepage": "https://github.com/KKKIIO/maple-moon#readme",
	"dependencies": {
		"@mantine/core": "^8.3.9",
		"@mantine/hooks": "^8.3.9",
		"@openrouter/sdk": "^0.9.11",
		"@tailwindcss/vite": "^4.1.10",
		"@types/node": "^24.10.1",
		"@uiw/react-json-view": "^2.0.0-alpha.39",
		"allotment": "^1.20.4",
		"canvas": "^3.2.0",
		"clsx": "^2.1.1",
		"leva": "^0.10.1",
		"lucide-react": "^0.555.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-hotkeys-hook": "^5.2.1",
		"sharp": "^0.34.5",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.10",
		"zustand": "^5.0.9"
	},
	"devDependencies": {
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"autoprefixer": "^10.4.22",
		"baseline-browser-mapping": "^2.9.19",
		"concurrently": "^9.2.4",
		"postcss": "^8.5.6",
		"vite": "^6.1.0"
	}
}
