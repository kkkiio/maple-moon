import {
  "KKKIIO/maple-moon/engine/game_app",
  "KKKIIO/maple-moon/engine/bot_controller",
  "KKKIIO/maple-moon/engine/console",
  "KKKIIO/maple-moon/engine/game_state",
  "Milky2018/selene/ecs",
  "Milky2018/selene/plugins",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  overrides: [
    "Milky2018/selene_webgpu/platform_window",
    "Milky2018/selene_webgpu/platform_input",
    "Milky2018/selene_webgpu/platform_render",
    "Milky2018/selene_webgpu/platform_audio",
    "Milky2018/selene_webgpu/platform_asset_io",
    "KKKIIO/maple-moon/engine/local_server/local_server_workaround",
  ],
  targets: { "main.mbt": [ "js" ] },
)
