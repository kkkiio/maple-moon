import {
  "KKKIIO/maple-moon/engine/game_app",
  "KKKIIO/maple-moon/engine/game_state",
  "KKKIIO/selene/ecs",
  "KKKIIO/selene/plugins",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  overrides: [
    "KKKIIO/selene_raylib/platform_window",
    "KKKIIO/selene_raylib/platform_input",
    "KKKIIO/selene_raylib/platform_render",
    "KKKIIO/selene_raylib/platform_audio",
    "KKKIIO/selene_raylib/platform_asset_io",
    "KKKIIO/maple-moon/engine/local_server/local_server_workaround",
  ],
  targets: { "main.mbt": [ "native" ] },
)
