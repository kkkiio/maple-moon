package "KKKIIO/maple-moon/engine/game_server"

import {
  "KKKIIO/maple-moon/engine/log",
  "KKKIIO/maple-moon/game/server_proto",
  "moonbitlang/core/json",
}

#callsite(autofill(loc))
fn[T : @server_proto.ClientMessage] send(
  T,
  log_level? : @log.Level,
  loc~ : SourceLoc
) -> Unit

fn add_server_message_handler(
  String,
  Int,
  (Json) -> Unit raise
) -> Unit

fn server_system(Double) -> Unit

fn init_server() -> Unit
