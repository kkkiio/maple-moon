  "4031737": {
    "desc": "Blood that is made by Homunculus's magic.  It has the power to reveal truth.",
    "name": "Homunculus's Blood",
  },
  "4031738": {
    "desc": "Medicine that Dran made for his daughter Kini.  It seems rather ordinary but it is actually very difficult to make.",
    "name": "Dran's Medicine",
  },
  "4031739": {
    "desc": "An orange magic stone that signifies humility. What kind of powers does this item have?",
    "name": "Magic Stone of Humility",
  },
  "4031740": {
    "desc": "A green magic stone that signifies honesty. What kind of powers does this item have?",
    "name": "Magic Stone of Honesty",
  },
  "4031741": {
    "desc": "A blue magic stone that signifies trust. What kind of powers does this item have?",
    "name": "Magic Stone of Trust",
  },
  "4031743": {
    "desc": "A medicine carried by Humanoid A. There's no way to tell what kind of effect it has when consumed.",
    "name": "Unknown Medicine",
  },
  "4031744": {
    "desc": "A pendant with a rose engraving.  It seems to be missing its chain.",
    "name": "Silver Pendant",
  },
  "4031745": {
    "desc": "Entry pass that was used by Parwen.  It looks like any other entry passes but has a different number on it.",
    "name": "Parwen's Entry Pass",
  },
  "4031750": {
    "desc": "Strange matter from the depths of space.  When used in the construction of items, who knows what effect it'll have!",
    "name": "Dark Matter",
  },
  "4031751": {
    "desc": "A futuristic machine part that perpetually makes whirling noises.  Once a part of a bigger machine, it can be used to create something new.",
    "name": "Vorticular Gyro",
  },
  "4031752": {
    "desc": "A futuristic machine part that blinks steadily and mysteriously.  It's original use is unknown but it can be broken down to create something else.",
    "name": "Blinking Dingbat",
  },
  "4031753": {
    "desc": "Residual matter from the explosion of a distant dying star that's taken eons to reach here. ",
    "name": "Zeta Residue",
  },
  "4031754": {
    "desc": "A form of concentrated energy, harvested from the alternate dimension of Versal. The dark energy denotes a chaotic element.",
    "name": "Black Versal Materia",
  },
  "4031755": {
    "desc": "An ancient totem that pulses with mystic energy.",
    "name": "Taru Totem",
  },
  "4031756": {
    "desc": "A golden instrument used for navigation.  Said to have magical effects when combined with other items. ",
    "name": "Mystic Astrolabe",
  },
  "4031757": {
    "desc": "An old world tablet with strange markings. These are said to combine with other objects.",
    "name": "Antellion Relic",
  },
  "4031758": {
    "desc": "A lost jewel created by Naricain, the demon sorceror. Said to add tremendous dark power to crafted items.",
    "name": "Naricain Jewel",
  },
  "4031759": {
    "desc": "One of Subani's Ankhs. Said to have protective powers and ward off darkness.",
    "name": "Subani Ankh",
  },
  "4031760": {
    "desc": "A form of concentrated energy, harvested from the alternate dimension of Versal. The blinding white energy indicates it is still unstable.",
    "name": "White Versal Materia",
  },
  "4031761": {
    "desc": "Materia from Versal that has been stabilized into an orb form.  It still pulses with energy. ",
    "name": "Materia Orb",
  },
