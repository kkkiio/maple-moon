    "desc": "An order believed to be written by Master M.",
    "name": "Master M's Order Scroll",
  },
  "4032001": {
    "desc": "A command believed to be written by Master M.",
    "name": "Master M's Command Scroll",
  },
  "4032002": {
    "desc": "This marble was created by Temple Keeper. It can break the barrier with the chaotic power within.",
    "name": "Marble of Chaos",
  },
  "4032003": {
    "desc": "A seed dropped by the possessed trees of Phantom Forest.",
    "name": "Phantom Seed",
  },
  "4032004": {
    "desc": "Resilient wood from the Crimson Tree.",
    "name": "Crimson Wood ",
  },
  "4032005": {
    "desc": "A feather from the mythical Typhon.  These are thought to contain the essence of their wind nature.",
    "name": "Typhon Feather",
  },
  "4032006": {
    "desc": "An emblem that marks one as a member of the Stormbreakers.",
    "name": "Stormbreaker Badge",
  },
  "4032007": {
    "desc": "An emblem that marks one as a member of the Windraiders.",
    "name": "Windraider Badge",
  },
  "4032008": {
    "desc": "An emblem that marks one as a member of the Firebrands.",
    "name": "Firebrand Badge",
  },
  "4032009": {
    "desc": "An emblem that marks one as a member of the Nightshadows.",
    "name": "Nightshadow Badge",
  },
  "4032010": {
    "desc": "The Elder Wraiths are spirits of Crimsonwood Keep heroes who fell in battle but were never buried.  These are the burnt ashes of their remains (ashes of the dead) and should basically look like a pile of grey dust.",
    "name": "Elder Ashes",
  },
  "4032011": {
    "desc": "The Elder Wraiths are spirits of Crimsonwood Keep heroes who fell in battle but were never buried.  These are the burnt ashes of their remains (ashes of the dead) and should basically look like a pile of grey dust.",
    "name": "Soiled Rags",
