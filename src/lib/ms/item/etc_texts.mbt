  "4032021": {
    "desc": "A futuristic, super-efficient power unit designed for everything from cybernetic protectors to microwaves.",
    "name": "Triferium Fuel Cell",
  },
  "4032022": {
    "desc": "A futuristic power unit suitable for powering everything from toasters to toy robot dogs.",
    "name": "Diferium Fuel Cell",
  },
  "4032023": {
    "desc": "A useful component for many electronic devices, especially cybernetic protectors. ",
    "name": "Sparkplug",
  },
  "4032024": {
    "desc": "A pair of jumper cables.  Anyone need a start?",
    "name": "Jumper Cable",
  },
  "4032025": {
    "desc": "Looks like a socket adapter for the T-1 line of robotic devices.",
    "name": "T-1 Socket Adapter",
  },
  "4032026": {
    "desc": "An ancient magical stone bearing the mark of Ridley, the master artisan-magician.  It hums when in vicinity of a Ridley's Statue.",
    "name": "Ridley's Stone",
  },
  "4032027": {
    "desc": "A wire coat hanger that can be bent into different shapes, for function or for fun.",
    "name": "Coat Hanger",
  },
  "4032028": {
    "desc": "A wad of gum that has been slightly chewed.  Still sticky!",
    "name": "Wad of Gum",
  },
  "4032029": {
    "desc": "A roll of silver duct tape.  Never know when this may come in handy!",
    "name": "Duct Tape",
  },
  "4032030": {
    "desc": "A piece of highly stretchy, elastic cloth.",
    "name": "Stretchy Material",
  },
  "4032031": {
    "desc": "A small silver lucky charm.  Hopefully, it'll bring you more luck than it did the leprechaun.",
    "name": "Lucky Charm",
  },
  "4032032": { "name": "Coded Communique" },
  "4032035": {
    "desc": "A Snipe that has lost her way. Take her and move up to a high point, where she can use the launch pad-like area to try to fly her way back home.",
    "name": "A Lost Snipe",
  },
  "4032036": {
    "desc": "As long as you have this with you, the Moon Bunny will give you the Sweet Rice Cake 5 times a day.",
    "name": "Special Ticket to the Moon",
  },
  "4032037": {
    "desc": "A single slice of beef. Marinate it, then grill it to try to make the Fire Grill Skewer.",
    "name": "Beef Slice",
  },
  "4032038": {
    "desc": "A single slice of dried mushroom. Mix it with some seasoning to make a Fire Grill Skewer.",
    "name": "Dry Mushroom",
  },
  "4032039": {
    "desc": "A whole bellflower that can be used as part of the Fire Grill Skewer if soaked in salt water",
    "name": "Whole Bellflower",
  },
  "4032040": {
    "desc": "Simply a Fire Grill Skewer placed on a pretty dish. Nothing says Thank You quite like a nice dish of Fire Grill Skewer.",
    "name": "Fire Grill Skewer Dish",
  },
  "4032041": {
    "desc": "A beautiful flower that apparently only grows on the moon. Constantly glitters, thanks to all that moonlight it's been soaking up.",
    "name": "Moon Flower",
  },
  "4032042": {
    "desc": "The first piece of photo of the moon. Collect the other two, and it'll turn into a photo of a beautiful full moon. Place the pictures inside the envelope to make sure they don't rip.",
    "name": "1st Moon Photo Piece",
  },
  "4032043": {
    "desc": "The second piece of photo of the moon. Collect the other two, and it'll turn into a photo of a beautiful full moon. Place the pictures inside the envelope to make sure they don't rip.",
    "name": "2nd Moon Photo Piece",
  },
  "4032044": {
    "desc": "The third piece of photo of the moon. Collect the other two, and it'll turn into a photo of a beautiful full moon. Place the pictures inside the envelope to make sure they don't rip.",
    "name": "3rd Moon Photo Piece",
  },
  "4032055": {
    "desc": "A ticket that's required to enter the Mini Dungeon during the event period. Without this, you won't be able to fully participate in the event.",
    "name": "Event Ticket (Regular)",
  },
  "4032056": {
    "desc": "A beautiful crystal with a red maple leaf inside. Hand this in to the Event Personnel, and she'll exchange this with a prize.",
    "name": "Magic Crystal",
  },
  "4032057": {
    "desc": "An attendance sheet that checks your daily attendance to MapleStory.",
    "name": "Attendance Sheet",
  },
  "4032058": {
    "desc": "A scrumptious Peanut Butter and Jelly Sandwich. The staple of lunch for all ages!",
    "name": "PB & J Sandwich",
  },
  "4032059": {
    "desc": "Rich Happyville chocolate combined with high-quality milk straight from the fields of Henesys. A delicious treat!",
    "name": "Chocolate Milk",
  },
  "4032060": {
    "desc": "An irresistible snack. Way too tasty to eat just one!",
    "name": "Chips",
  },
  "4032061": {
    "desc": "A chocolate chip cookie found in the wild, now prepared to eat. Guaranteed to bring a smile to someone's face. ",
    "name": "Cookie",
