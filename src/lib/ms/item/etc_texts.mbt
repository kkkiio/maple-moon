  "4032012": {
    "desc": "A dark red crystal that pulses with unknown energy, used to power the Crimson Guardians.",
    "name": "Crimson Heart",
  },
  "4032013": {
    "desc": "The big toe of Bigfoot.  Even though it has a pretty ribbon tied around it, it still looks kinda gross.",
    "name": "Bigfoot's Toe",
  },
  "4032014": {
    "desc": "A letter the Jack has written to John.  It seems to be written in some secret code known only between the Barricade Brothers.",
    "name": "Jack's Letter to John",
  },
  "4032015": {
    "desc": "A ancient Shadowknight artifact.  Its use is known only to the Raven Ninjas.",
    "name": "Tao of Shadows",
  },
  "4032016": {
    "desc": "A ancient Shadowknight artifact.  Its use is known only to the Raven Ninjas.",
    "name": "Tao of Sight",
  },
  "4032017": {
    "desc": "A ancient Shadowknight artifact.  Its use is known only to the Raven Ninjas.",
    "name": "Tao of Harmony",
  },
