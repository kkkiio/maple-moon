  "4280000": {
    "desc": "A gold treasure chest dropped by a monster. This can be opened with the Gold Master Key available at the Cash Shop. If you already have the Master Key, just double-click the box to open it.",
    "name": "Gold Box",
  },
  "4280001": {
    "desc": "A silver treasure chest dropped by a monster. This can be opened with the Silver Master Key available at the Cash Shop. If you already have the Master Key, just double-click the box to open it.",
    "name": "Silver Box",
  },
  "4280002": {
    "desc": "A gold treasure chest dropped by a monster. This can be opened with the Premium Gold Master Key available at the Cash Shop. If you already have the Premium Gold Master Key, just double-click the box to open it.",
    "name": "Premium Gold Box",
  },
  "4280003": {
    "desc": "A silver treasure chest dropped by a monster. This can be opened with the Premium Silver Master Key available at the Cash Shop. If you already have the Premium Silver Master Key, just double-click the box to open it.",
    "name": "Premium Silver Box",
  },
  "4290000": {
    "desc": "Golden Chicken Effect was given as a reward for helping Lazy Daisy. You can turn it ON/OFF by double-clicking the icon or using the key configuration menu to assign a shortcut key. ",
    "name": "Golden Chicken Effect",
  },
  "4290001": {
    "desc": "This effect is for people who helped Lazy Daisy but failed to hatch the egg. You can turn it ON/OFF by double-clicking the icon or using the key configuration menu to assign a shortcut key. ",
    "name": "Bummer Effect",
  },
  "4300000": {
    "desc": "A beautiful card with season's greetings.",
    "name": "New Year's Card (Send)",
  },
  "4301000": {
    "desc": "A beautiful card with season's greetings. Double click on it to read!",
    "name": "New Year's Card (Receive)",
  },
  "4310000": {
    "desc": "This Music Note gives Inkwell the perfect pitch he's been dying to find. You can trade it for a rare item if you go to the Free Market Entrance or talk to Inkwell in Henesys before March 30th.",
    "name": "Perfect Pitch",
  },
}
