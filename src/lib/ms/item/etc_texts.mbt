  "4031979": {
    "desc": "A piece of paper with illegible doodling on it.\\n#Mix gold and iron in the ratio of 6:2, then cover it with wisdom and courage stored in Lithium.# Then...",
    "name": "Doodly Paper",
  },
  "4031980": { "desc": "An anvil that glows in gold.", "name": "Gold Anvil" },
  "4031988": {
    "desc": "Item Agent O asked me to retrieve.  I should take it back to Agent O.",
    "name": "Special Agent Badge",
  },
  "4031991": {
    "desc": "This is Timer's egg. It's too hard to crack. Ghosthunter Bob must know what to do with this.",
    "name": "Timer's Egg",
  },
  "4031992": {
    "desc": "This little worm lives in Ludirium. It's so small it's not at all threatening.",
    "name": "Springy Worm",
  },
  "4031993": {
    "desc": "A savory juice that Bartos really likes to drink.",
    "name": "Bartos' Favorite Juice",
  },
  "4031999": {
    "desc": "Directions believed be written by Master M.",
    "name": "Master M's Direction Scroll",
  },
