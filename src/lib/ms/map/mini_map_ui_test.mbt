///|
test "parse portal marker" {
  let json = @json.parse(
    (
      #| {"0":{"pn":"sp","pt":0,"tm":999999999,"tn":"","x":-289,"y":227},"1":{"pn":"sp","pt":0,"tm":999999999,"tn":"","x":-147,"y":235},"2":{"pn":"sp","pt":0,"tm":999999999,"tn":"","x":-68,"y":235},"3":{"pn":"sp","pt":0,"tm":999999999,"tn":"","x":2,"y":237},"4":{"pn":"sp","pt":0,"tm":999999999,"tn":"","x":84,"y":234},"5":{"pn":"sp","pt":0,"tm":999999999,"tn":"","x":2685,"y":57},"6":{"pn":"sp","pt":0,"tm":999999999,"tn":"","x":2752,"y":59},"7":{"pn":"sp","pt":0,"tm":999999999,"tn":"","x":2836,"y":58},"8":{"pn":"sp","pt":0,"tm":999999999,"tn":"","x":2900,"y":60},"9":{"pn":"sp","pt":0,"tm":999999999,"tn":"","x":3064,"y":48},"10":{"pn":"west00","pt":2,"tm":105050100,"tn":"east00","x":-222,"y":318},"11":{"pn":"east00","pt":2,"tm":105050300,"tn":"west00","x":3013,"y":138}}
    ),
  )
  let portal_markers : @resource.MapBasedArray[NxPortal] = @json.from_json(json)
  json_inspect(portal_markers.0, content=[
    {
      "pn": "sp",
      "tm": 999999999,
      "tn": "",
      "x": -289,
      "y": 227,
      "pt": "SPAWN",
    },
    {
      "pn": "sp",
      "tm": 999999999,
      "tn": "",
      "x": -147,
      "y": 235,
      "pt": "SPAWN",
    },
    { "pn": "sp", "tm": 999999999, "tn": "", "x": -68, "y": 235, "pt": "SPAWN" },
    { "pn": "sp", "tm": 999999999, "tn": "", "x": 2, "y": 237, "pt": "SPAWN" },
    { "pn": "sp", "tm": 999999999, "tn": "", "x": 84, "y": 234, "pt": "SPAWN" },
    { "pn": "sp", "tm": 999999999, "tn": "", "x": 2685, "y": 57, "pt": "SPAWN" },
    { "pn": "sp", "tm": 999999999, "tn": "", "x": 2752, "y": 59, "pt": "SPAWN" },
    { "pn": "sp", "tm": 999999999, "tn": "", "x": 2836, "y": 58, "pt": "SPAWN" },
    { "pn": "sp", "tm": 999999999, "tn": "", "x": 2900, "y": 60, "pt": "SPAWN" },
    { "pn": "sp", "tm": 999999999, "tn": "", "x": 3064, "y": 48, "pt": "SPAWN" },
    {
      "pn": "west00",
      "tm": 105050100,
      "tn": "east00",
      "x": -222,
      "y": 318,
      "pt": "REGULAR",
    },
    {
      "pn": "east00",
      "tm": 105050300,
      "tn": "west00",
      "x": 3013,
      "y": 138,
      "pt": "REGULAR",
    },
  ])
}

