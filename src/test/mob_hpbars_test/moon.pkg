import {
  "moonbitlang/core/random",
  "KKKIIO/maple-moon/lib/ms/monster",
  "KKKIIO/maple-moon/lib/ms/animation" @ms_animation,
  "KKKIIO/maple-moon/lib/ms/physics",
  "KKKIIO/maple-moon/lib/ms/res_types" @struct,
  "KKKIIO/maple-moon/test/capture_app",
  "Milky2018/selene/entity",
  "Milky2018/selene/math",
  "KKKIIO/maple-moon/lib/ms/transform2d",
  "KKKIIO/maple-moon/lib/ms/camera" @ms_camera,
  "Milky2018/selene/plugins",
  "Milky2018/selene/sprite",
  "Milky2018/selene/system",
  "Milky2018/selene/app",
  "Milky2018/selene/ecs",
