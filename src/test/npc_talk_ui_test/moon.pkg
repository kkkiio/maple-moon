import {
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "KKKIIO/maple-moon/lib/game_state",
  "KKKIIO/maple-moon/lib/graphics",
  "KKKIIO/maple-moon/lib/io_service",
  "KKKIIO/maple-moon/lib/resource",
  "KKKIIO/maple-moon/lib/ui",
  "KKKIIO/maple-moon/lib/ms/cursor",
  "KKKIIO/maple-moon/lib/ms/npc",
  "KKKIIO/maple-moon/lib/ms/npc_talk_ui",
  "KKKIIO/maple-moon/test/capture_app",
  "Milky2018/selene/plugins",
  "Milky2018/selene/system",
  "Milky2018/selene/system_set",
  "Milky2018/selene/inputs",
  "Milky2018/selene/ui" @selene_ui,
  "KKKIIO/maple-moon/lib/ms/camera" @ms_camera,
  "Milky2018/selene/entity",
  "Milky2018/selene/math",
  "Milky2018/selene/app",
