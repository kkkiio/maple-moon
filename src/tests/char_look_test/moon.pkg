import {
  "Milky2018/selene/sprite",
  "Milky2018/selene/math",
  "moonbitlang/core/json",
  "KKKIIO/maple-moon/game/char_look",
  "KKKIIO/maple-moon/game/character_presentation" @cp,
  "KKKIIO/maple-moon/game/char_look/types",
  "KKKIIO/maple-moon/game/item",
  "KKKIIO/maple-moon/game/equip/slot",
  "moonbitlang/x/fs",
  "Milky2018/selene/entity",
  "KKKIIO/maple-moon/game/transform2d",
  "KKKIIO/maple-moon/tests/capture_app",
  "Milky2018/selene/app",
  "Milky2018/selene/plugins",
  "KKKIIO/maple-moon/game/char_stance",
  "KKKIIO/maple-moon/engine/resource",
  "Milky2018/selene/ecs",
  "Milky2018/selene/transform",
} for "test"

supported_targets = "native"

options(
  overrides: [
    "Milky2018/selene_raylib/platform_window",
    "Milky2018/selene_raylib/platform_input",
    "Milky2018/selene_raylib/platform_render",
    "Milky2018/selene_raylib/platform_audio",
    "Milky2018/selene_raylib/platform_asset_io",
  ],
)
