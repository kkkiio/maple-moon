import {
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "KKKIIO/maple-moon/engine/game_state",
  "KKKIIO/maple-moon/engine/graphics",
  "KKKIIO/maple-moon/engine/io_service",
  "KKKIIO/maple-moon/engine/resource",
  "KKKIIO/maple-moon/engine/ui",
  "KKKIIO/maple-moon/game/cursor",
  "KKKIIO/maple-moon/game/npc",
  "KKKIIO/maple-moon/game/ui/npc_talk_ui",
  "KKKIIO/maple-moon/tests/capture_app",
  "Milky2018/selene/plugins",
  "Milky2018/selene/system",
  "Milky2018/selene/system_set",
  "Milky2018/selene/inputs",
  "Milky2018/selene/ui" @selene_ui,
  "KKKIIO/maple-moon/game/camera" @ms_camera,
  "Milky2018/selene/entity",
  "Milky2018/selene/math",
  "Milky2018/selene/app",
  "Milky2018/selene/ecs",
} for "test"

supported_targets = "js"

options(
  overrides: [
    "Milky2018/selene_webgpu/platform_window",
    "Milky2018/selene_webgpu/platform_input",
    "Milky2018/selene_webgpu/platform_render",
    "Milky2018/selene_webgpu/platform_audio",
    "Milky2018/selene_webgpu/platform_asset_io",
  ],
)
